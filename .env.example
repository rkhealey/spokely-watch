# Postgres connection string (Supabase). Added in the database-layer chunk.
DATABASE_URL=

# Shared secret NestJS must send as the `x-api-key` header when posting to
# /api/ingest/jobs. Added in the ingestion-API chunk.
INGEST_API_KEY=

# Base URL of the spokely-api host, used to call its internal retry endpoint
# (POST /internal/spokely-watch/retry) when the Retry button is clicked.
SPOKELY_API_URL=

# Secret spokely-api expects as the `x-api-key` header on that retry call.
# Separate from INGEST_API_KEY — spokely-api sets this in their own env
# (Render, as SPOKELY_WATCH_INBOUND_SECRET) and hands us the value.
SPOKELY_WATCH_INBOUND_SECRET=

# Shared password for the dashboard login page. Added in the auth chunk.
ADMIN_PASSWORD=

# Random string used to sign the admin session cookie. Added in the auth chunk.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
