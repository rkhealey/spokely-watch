generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum Environment {
  PRODUCTION
  DEVELOPMENT
}

model Job {
  id               String      @id @default(cuid())
  externalId       String      @unique
  // The pipeline's show/podcast identifier — not set on jobs ingested before
  // this field existed, so always optional in queries and UI.
  showId           String?
  showName         String?
  // Defaults to PRODUCTION so jobs ingested before this field existed (and
  // any payload that omits it) are treated as real production traffic.
  environment      Environment @default(PRODUCTION)
  status           JobStatus
  audioDurationSec Float?
  startedAt        DateTime?
  completedAt      DateTime?
  processingMs     Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  runpodUsage    RunpodUsage[]
  anthropicUsage AnthropicUsage[]
  error          JobError?

  @@index([createdAt])
  @@index([status])
  @@index([showId])
  @@index([environment])
}

model RunpodUsage {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Which container this run was, e.g. "transcribe" / "diarize" — a job can
  // have multiple RunPod containers running in parallel on the same episode.
  task        String?
  endpointId  String?
  gpuType     String
  executionMs Int
  delayMs     Int
  costUsd     Decimal  @db.Decimal(10, 4)
  createdAt   DateTime @default(now())

  @@index([jobId])
}

model AnthropicUsage {
  id                  String   @id @default(cuid())
  jobId               String
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  model               String
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  costUsd             Decimal  @db.Decimal(10, 4)
  createdAt           DateTime @default(now())

  @@index([jobId])
}

model JobError {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  code      String?
  message   String
  stage     String?
  createdAt DateTime @default(now())
}
