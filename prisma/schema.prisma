generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  PROCESSING
  // Checkpoint: transcription finished and the episode isn't necessarily
  // going any further right now — it may be picked up for full processing
  // immediately, much later, or never. Not a failure and not final.
  TRANSCRIBED
  SUCCEEDED
  FAILED
}

enum Environment {
  PRODUCTION
  DEVELOPMENT
}

enum StepStatus {
  STARTED
  SUCCEEDED
  FAILED
}

model Job {
  id               String      @id @default(cuid())
  externalId       String      @unique
  // The pipeline's show/podcast identifier — not set on jobs ingested before
  // this field existed, so always optional in queries and UI.
  showId           String?
  showName         String?
  // Defaults to PRODUCTION so jobs ingested before this field existed (and
  // any payload that omits it) are treated as real production traffic.
  environment      Environment @default(PRODUCTION)
  status           JobStatus
  audioDurationSec Float?
  startedAt        DateTime?
  completedAt      DateTime?
  processingMs     Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  runpodUsage    RunpodUsage[]
  anthropicUsage AnthropicUsage[]
  steps          JobStep[]
  error          JobError?

  @@index([createdAt])
  @@index([status])
  @@index([showId])
  @@index([environment])
}

// One row per pipeline step, upserted in place as the step progresses
// (STARTED -> SUCCEEDED/FAILED) rather than appended — unlike RunpodUsage/
// AnthropicUsage, a step is a single unit of work, not a log of calls.
// `step` is a free-text name matched against RunpodUsage.task and
// AnthropicUsage.step so cost can be joined in by name in the dashboard.
model JobStep {
  id          String     @id @default(cuid())
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step        String
  status      StepStatus
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([jobId, step])
  @@index([jobId])
}

// One row per (job, task), upserted in place — not deleted and recreated on
// every /api/ingest/jobs call. This is what lets a checkpoint's cost (e.g.
// transcription) survive a later completion report that only carries the
// steps that ran since: the pipeline never has to remember or resend cost
// for a step it isn't reporting on this call.
model RunpodUsage {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Which container this run was, e.g. "transcription" / "diarization" — a
  // job can have multiple RunPod containers running in parallel. Nullable
  // only for rows written before this field was required; always required
  // on new writes so the (jobId, task) upsert key is reliable.
  task        String?
  endpointId  String?
  gpuType     String
  executionMs Int
  delayMs     Int
  costUsd     Decimal  @db.Decimal(10, 4)
  createdAt   DateTime @default(now())

  @@unique([jobId, task])
  @@index([jobId])
}

// Same upsert-in-place contract as RunpodUsage, keyed by (jobId, step). A
// step's multiple Claude calls must be pre-aggregated into one row before
// sending, since only one row per step can exist.
model AnthropicUsage {
  id                  String   @id @default(cuid())
  jobId               String
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Which pipeline step this call belongs to, e.g. "llm" — mirrors
  // RunpodUsage.task. Nullable only for pre-existing rows; always required
  // on new writes.
  step                String?
  model               String
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  costUsd             Decimal  @db.Decimal(10, 4)
  createdAt           DateTime @default(now())

  @@unique([jobId, step])
  @@index([jobId])
}

model JobError {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  code      String?
  message   String
  stage     String?
  // Specific pipeline step running when the job failed, e.g. "diarize" —
  // finer-grained than `stage`. Set independently of any JobStep row, since
  // a hard crash may skip reporting a step-level failure event entirely.
  step      String?
  createdAt DateTime @default(now())
}
